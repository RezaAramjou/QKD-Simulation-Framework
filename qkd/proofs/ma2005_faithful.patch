+    # ------------------------------------------------------------------
+    # Paper Eq (5): overall transmission efficiency
+    # ------------------------------------------------------------------
+    def _get_eta(self) -> float:
+        """
+        Paper Eq (5): eta = t_AB * eta_Bob, where eta_Bob = t_Bob * eta_D
+        is given directly in Table 1 as a single experimental quantity
+        (GYS: 0.045; KTH: 0.143). Prefer the explicitly-provided eta_Bob
+        over the product of sub-quantities, since the paper treats eta_Bob
+        as a primitive parameter.
+        """
+        eta_bob = getattr(self.p.detector, "eta_bob", None)
+        if eta_bob is None:
+            # Fallback: reconstruct from t_Bob and eta_D if exposed.
+            t_bob = getattr(self.p.detector, "t_bob", 1.0)
+            eta_d = getattr(self.p.detector, "det_eff_d0", 0.0)
+            eta_bob = t_bob * eta_d
+        return float(self.p.channel.transmittance * eta_bob)
+
+    # ------------------------------------------------------------------
+    # Paper Table 1 / Sec 2: Y_0 is the *total* background rate
+    # ------------------------------------------------------------------
+    def _get_y0(self, stats_map: Optional[Dict[str, "TallyCounts"]] = None) -> float:
+        """
+        Paper Table 1 treats Y_0 as a primitive experimental parameter
+        (GYS: 1.7e-6; KTH: 4e-4) — already the *total* background rate,
+        not per-detector. Do NOT multiply dark_rate by 2.
+
+        If vacuum-decoy statistics are available (V+W protocol, Eq 33),
+        use Q_vacuum = Y_0 directly. Otherwise fall back to the configured
+        Y_0; only as a last resort use dark_rate (interpreted as total).
+        """
+        if stats_map is not None:
+            vac = stats_map.get("vacuum")
+            if vac is not None and vac.sent > 0:
+                return float(vac.sifted) / float(vac.sent)
+        y0 = getattr(self.p.detector, "y0", None)
+        if y0 is not None:
+            return float(y0)
+        # Last-resort fallback: dark_rate is interpreted as TOTAL (not per-detector).
+        return float(getattr(self.p.detector, "dark_rate", 0.0))
+
+    # ------------------------------------------------------------------
+    # Paper Eq (45): basis reconciliation factor for finite data
+    # ------------------------------------------------------------------
+    def _calculate_sifting_factor_q(
+        self,
+        signal_sent: int,
+        total_sent: int,
+    ) -> float:
+        """
+        Paper Eq (45): q = N_S / (2N) for standard BB84.
+        In the asymptotic limit N_S -> N, q -> 1/2.
+        For efficient BB84 (q ~ 1) the user may set self.p.sifting_factor_q
+        explicitly to override this finite-size formula.
+        """
+        # Allow explicit override for efficient-BB84 or other protocols.
+        override = getattr(self.p, "sifting_factor_q", None)
+        if override is not None:
+            return float(override)
+        if total_sent > 0:
+            return float(signal_sent) / (2.0 * float(total_sent))
+        return 0.5
+
+    # ------------------------------------------------------------------
+    # Paper Eq (12): optimal signal intensity mu
+    # ------------------------------------------------------------------
+    @staticmethod
+    def solve_optimal_mu(
+        e_detector: float,
+        f_ec: float,
+        tol: float = 1e-12,
+        max_iter: int = 200,
+    ) -> float:
+        """
+        Solve Paper Eq (12):
+            (1 - mu) * exp(-mu) = f(e_det) * H2(e_det) / (1 - H2(e_det))
+        for mu in (0, 1] via bisection.
+
+        Sanity reference (from Section 8 of spec):
+            GYS, f=1.0:   mu ~= 0.54
+            GYS, f=1.22:  mu ~= 0.48
+        """
+        h2 = binary_entropy(e_detector)
+        if h2 >= 1.0:
+            # e_detector = 1/2 -> RHS undefined; mu degenerate.
+            return 1.0
+        rhs = f_ec * h2 / (1.0 - h2)
+
+        def g(mu: float) -> float:
+            return (1.0 - mu) * math.exp(-mu) - rhs
+
+        # g(0) = 1 - rhs > 0  for typical e_det < 0.5
+        # g(1) = -rhs        < 0
+        g_hi = g(1.0)
+        if g_hi >= 0.0:
+            return 1.0  # all positive -> pick boundary
+        lo, hi = 1e-12, 1.0
+        for _ in range(max_iter):
+            mid = 0.5 * (lo + hi)
+            g_mid = g(mid)
+            if abs(g_mid) < tol or (hi - lo) < tol:
+                return mid
+            if g_mid > 0.0:
+                lo = mid
+            else:
+                hi = mid
+        return 0.5 * (lo + hi)
+
